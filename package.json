{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:ssr": "vite build --ssr scripts/ssr-entry.jsx --outDir dist-ssr",
    "check:head": "node scripts/check-head.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:render": "npm run build:ssr && node scripts/check-render.mjs",
    "shots": "node scripts/shoot.mjs",
    "check:reveals": "node scripts/audit-reveals.mjs",
    "check:work": "node scripts/audit-work.mjs",
    "check:headings": "node scripts/audit-headings.mjs",
    "check:marquee": "node scripts/audit-marquee.mjs",
    "check:intro": "node scripts/audit-intro.mjs",
    "check:figure": "node scripts/audit-figure.mjs",
    "check:world": "node scripts/audit-world.mjs",
    "check:occlusion": "node scripts/audit-occlusion.mjs",
    "shots:intro": "node scripts/shoot-intro.mjs",
    "shots:figure": "node scripts/shoot-figure.mjs",
    "verify": "npm run lint && npm run build && npm run check:head && npm run check:contrast && npm run check:assets && npm run check:render"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lenis": "^1.3.17",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
