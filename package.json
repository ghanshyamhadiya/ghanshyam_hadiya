{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:ssr": "vite build --ssr scripts/ssr-entry.jsx --outDir dist-ssr",
    "check:head": "node scripts/check-head.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:radius": "node scripts/check-radius.mjs && node scripts/check-built-css.mjs",
    "check:render": "npm run build:ssr && node scripts/check-render.mjs",
    "shots": "node scripts/shoot.mjs",
    "check:reveals": "node scripts/audit-reveals.mjs",
    "check:cards": "node scripts/measure.mjs",
    "verify": "npm run lint && npm run build && npm run check:head && npm run check:contrast && npm run check:radius && npm run check:render"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lenis": "^1.3.17",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.1"
  }
}
